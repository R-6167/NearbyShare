<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WarPair"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/smokeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Run core smoke test" />

        <Button
            android:id="@+id/libraryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open library" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Device name"
            android:inputType="textPersonName"
            android:text="Pixel" />

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Peer IP (peer list / QR)"
            android:inputType="text" />

        <Button
            android:id="@+id/softApButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start SoftAP (no shared Wi‑Fi)" />

        <EditText
            android:id="@+id/qrPayloadInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="warpair://connect?host=…"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/showQrButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Show QR" />

            <Button
                android:id="@+id/applyQrButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apply QR" />
        </LinearLayout>

        <Button
            android:id="@+id/discoverButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover peers (mDNS)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peers — tap to select:"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/peersList"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:dividerHeight="1dp" />

        <Button
            android:id="@+id/pickFileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick file(s) to send" />

        <TextView
            android:id="@+id/pickedFileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No files selected"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/payloadInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fallback text → note.txt"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:text="Hello from WarPair" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Host" />

            <Button
                android:id="@+id/joinButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Join + send" />
        </LinearLayout>

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Cancel transfer" />
    </LinearLayout>
</ScrollView>
