<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NearbyShare demo"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/smokeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Run core smoke test" />

        <Button
            android:id="@+id/libraryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open library" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Device name"
            android:inputType="textPersonName"
            android:text="Pixel" />

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Peer IP (or tap a peer below)"
            android:inputType="text" />

        <Button
            android:id="@+id/discoverButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover peers (mDNS)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peers — tap to select:"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/peersList"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:dividerHeight="1dp" />

        <Button
            android:id="@+id/pickFileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick file(s) to send" />

        <TextView
            android:id="@+id/pickedFileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No files selected (Join will send the text below as note.txt)"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/payloadInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fallback text → note.txt if no files picked"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:text="Hello from NearbyShare" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Host (receive)" />

            <Button
                android:id="@+id/joinButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Join + send" />
        </LinearLayout>

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Cancel transfer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap a peer to select. Cancel keeps partials so the next send can Resume."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
