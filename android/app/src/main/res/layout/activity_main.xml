<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NearbyShare demo"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/smokeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Run core smoke test" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Device name"
            android:inputType="textPersonName"
            android:text="Pixel" />

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Peer IP (auto-filled by Discover)"
            android:inputType="text" />

        <Button
            android:id="@+id/discoverButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover peers (mDNS)" />

        <TextView
            android:id="@+id/peersText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peers: (none yet)"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/pickFileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick file to send" />

        <TextView
            android:id="@+id/pickedFileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No file selected (Join will send the text below as note.txt)"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/payloadInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fallback text → note.txt if no file picked"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:text="Hello from NearbyShare" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Host (receive)" />

            <Button
                android:id="@+id/joinButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Join + send" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Host advertises via mDNS. Discover fills the first peer IP. Progress updates while transferring. Max 64 MiB."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
