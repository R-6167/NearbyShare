<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="WarPair Orbit"
                android:src="@drawable/ic_orbit" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WarPair"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Move files. Not through hoops."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quickSendButton"
                android:layout_width="0dp"
                android:layout_height="108dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Send"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="18dp"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                app:iconTint="?attr/colorOnPrimary"
                app:icon="@drawable/ic_send"
                app:iconGravity="top"
                app:iconSize="30dp"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quickReceiveButton"
                android:layout_width="0dp"
                android:layout_height="108dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Receive"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="18dp"
                app:backgroundTint="?attr/colorSurface"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp"
                android:textColor="?attr/colorOnSurface"
                app:iconTint="?attr/colorPrimary"
                app:icon="@drawable/ic_inbox"
                app:iconGravity="top"
                app:iconSize="30dp"
                app:iconPadding="8dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickScanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Scan to connect"
            android:textAllCaps="false"
            app:icon="@drawable/ic_qr_scan"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:iconPadding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quickFilesButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Files"
                android:textAllCaps="false"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quickToolsButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="More tools"
                android:textAllCaps="false"
                app:icon="@drawable/ic_tune"
                app:iconGravity="textStart"
                app:iconSize="20dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorControlHighlight"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connection status"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ready when you are. Choose Send or Receive to begin."
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:enabled="false"
                    android:text="Cancel current operation" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/advancedPairingHeading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Connection tools"
            android:textColor="?attr/colorOnSurface"
            android:textSize="19sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/advancedPairingCard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorControlHighlight"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="This device name"
                    android:inputType="textPersonName"
                    android:text="WarPair device" />

                <EditText
                    android:id="@+id/hostInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Other device IP address"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/portInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="TCP port"
                    android:inputType="number"
                    android:text="19730" />

                <Button
                    android:id="@+id/discoverButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Find nearby WarPair devices" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Nearby devices — tap one to fill its address"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />

                <ListView
                    android:id="@+id/peersList"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:dividerHeight="1dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Bluetooth devices — paired devices and nearby discoverable phones"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/bluetoothDiscoverButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Find Bluetooth devices" />

                <ListView
                    android:id="@+id/bluetoothPeersList"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:dividerHeight="1dp" />

                <Button
                    android:id="@+id/bluetoothHostButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Make discoverable &amp; receive over Bluetooth" />

                <Button
                    android:id="@+id/bluetoothJoinButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect to selected Bluetooth device" />

                <Button
                    android:id="@+id/wifiDirectDiscoverButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Find Wi-Fi Direct devices" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Wi-Fi Direct peers — tap one to select"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />

                <ListView
                    android:id="@+id/wifiDirectPeersList"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:dividerHeight="1dp" />

                <Button
                    android:id="@+id/wifiDirectHostButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Host over Wi-Fi Direct" />

                <Button
                    android:id="@+id/wifiDirectJoinButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect to selected Wi-Fi Direct peer" />

                <Button
                    android:id="@+id/softApButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Create a direct Wi-Fi hotspot" />

                <EditText
                    android:id="@+id/qrPayloadInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste a WarPair QR link here"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/showQrButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show my QR" />

                    <Button
                        android:id="@+id/scanQrButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Scan QR" />
                </LinearLayout>

                <Button
                    android:id="@+id/applyQrButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use pasted QR link" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/advancedTransferHeading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Manual transfer controls"
            android:textColor="?attr/colorOnSurface"
            android:textSize="19sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/advancedTransferCard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorControlHighlight"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/pickFileButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose files to send" />

                <TextView
                    android:id="@+id/pickedFileText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="No files selected"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/payloadInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Or send a short text note"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:text="Hello from WarPair" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/hostButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Host / Receive" />

                    <Button
                        android:id="@+id/joinButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Connect / Send" />
                </LinearLayout>

                <Button
                    android:id="@+id/libraryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open received files" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/smokeButton"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Run connection core self-test" />
    </LinearLayout>
</ScrollView>
